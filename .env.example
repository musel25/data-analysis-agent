# ─── The provider ────────────────────────────────────────────────────────────────────────────
# base_url + api_key IS the entire integration. That is not a boast — it is why docs/DECISIONS.md
# D01 refuses a framework. Swap these two lines and the agent, the ledgers, the gates, the cache
# and the 4,480-run eval harness all keep working, unchanged.

# (a) Nebius Token Factory — what the evaluation was actually measured on
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=

# (b) Your own GPU. `uv run modal deploy infra/modal_vllm.py`, then:
# LLM_BASE_URL=https://<you>--research-agent-vllm-serve.modal.run/v1
# LLM_API_KEY=<the value you put in the `research-agent-llm` Modal secret>

# (c) A free tier, if you only want to poke at it (all OpenAI-compatible):
# LLM_BASE_URL=https://api.groq.com/openai/v1                       AGENT_MODEL=qwen/qwen3-32b
# LLM_BASE_URL=https://openrouter.ai/api/v1                         AGENT_MODEL=qwen/qwen3-30b-a3b:free
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AGENT_MODEL=gemini-2.5-flash

# ─── YOU PROBABLY DO NOT NEED A KEY AT ALL ───────────────────────────────────────────────────
# All 8 notebooks replay from the committed response cache with no key and no network:
#
#     from agentlib import set_live
#     set_live(False)
#
# A key is only needed to ask the agent something NEW. Verified from a fresh clone at a foreign
# path, with the environment scrubbed — see D30, which is the bug that made that claim false for
# everyone but me.

# ─── Models (optional overrides) ─────────────────────────────────────────────────────────────
# ⚠️  Changing AGENT_MODEL invalidates the cache: the model name is in the cache key, so every
#     request becomes a miss and nothing replays. Leave it alone unless you mean to spend money.
# AGENT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# VERIFIER_MODEL=openai/gpt-oss-120b
